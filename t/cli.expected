CSI_DISPATCH 'm' inter="" params=[1,31]
PRINT U+0068 'h'
PRINT U+0069 'i'
OSC_START
OSC_PUT 0x30
OSC_PUT 0x3B
OSC_PUT 0x77
OSC_PUT 0x69
OSC_PUT 0x6E
OSC_END payload="0;win"
ESC_DISPATCH '\' inter=""
PRINT U+00E3
EXECUTE 0x81 C1
EXECUTE 0x82 C1
HOOK 'q' inter="+" params=[]
PUT 0x35
PUT 0x34
PUT 0x34
PUT 0x65
UNHOOK payload="544e"
ESC_DISPATCH '\' inter=""
EXECUTE 0x0A LF
EOF state=GROUND
